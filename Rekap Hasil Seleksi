    <script>
        function filterTable() {
            const input = document.getElementById("searchBar");
            const filter = input.value.toLowerCase();
            const table = document.getElementById("santriTable");
            const tr = table.getElementsByTagName("tr");

            for (let i = 1; i < tr.length; i++) {
                let rowVisible = false;
                const tdNama = tr[i].getElementsByTagName("td")[1];
                const tdSekolah = tr[i].getElementsByTagName("td")[2];
                
                if (tdNama || tdSekolah) {
                    const textNama = tdNama.textContent || tdNama.innerText;
                    const textSekolah = tdSekolah.textContent || tdSekolah.innerText;
                    
                    if (textNama.toLowerCase().indexOf(filter) > -1 || textSekolah.toLowerCase().indexOf(filter) > -1) {
                        rowVisible = true;
                    }
                }
                tr[i].style.display = rowVisible ? "" : "none";
            }
        }
    </script>
